# Path to the Policy file (hot reloaded). Default: policy.yaml in the repository root.
# POLICY_PATH=../policy.yaml
# SQLite for local dev; Compose uses postgresql+asyncpg://firewall:firewall@postgres:5432/firewall
DATABASE_URL=sqlite+aiosqlite:///./firewall.db
# Timeout for proxy-mode Upstream calls.
UPSTREAM_TIMEOUT_SECONDS=60

# OpenAI-compatible Ollama endpoint; used by the preset upstream entries.
OLLAMA_API_BASE=http://localhost:11434/v1

# Empty disables telemetry; full OTLP/HTTP traces endpoint.
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_PROJECT=ai-control-layer

# Tool runs: disable Ollama thinking for responsive demos; default keeps model settings.
OLLAMA_TOOL_REASONING_EFFORT=none

# Claude models (provider: anthropic). Read by the firewall only; empty = Claude calls fail closed.
ANTHROPIC_API_KEY=
