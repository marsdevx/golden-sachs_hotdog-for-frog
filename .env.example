# Docker Compose settings. Copy to .env (`cp .env.example .env`); Compose reads it automatically.
# Every value is optional: the defaults below match the ones built into compose.yaml.
# For running the services without Docker, see firewall/.env.example and chat/.env.example.

# --- Host ports (bound to 127.0.0.1 only) ---
CHAT_PORT=8000
FIREWALL_PORT=8001

# --- Chat (the Agent) ---
# Model the chat asks the firewall for: mock, an Ollama model (e.g. qwen3:4b) or a Claude model
# (e.g. claude-haiku-4-5). The model must be listed in the Policy's allowed_models / upstreams.
LLM_MODEL=mock
# Covers the firewall checks and the model call.
FIREWALL_TIMEOUT_SECONDS=130
# Key the chat presents to the firewall; must match an agent in policy.yaml.
AGENT_KEY=demo-agent-key

# --- Firewall ---
# Timeout for proxy-mode Upstream calls.
UPSTREAM_TIMEOUT_SECONDS=60
# OpenAI-compatible Ollama endpoint as seen from inside the container.
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
# Tool runs: disable Ollama thinking for responsive demos; default keeps model settings.
OLLAMA_TOOL_REASONING_EFFORT=none
# Claude models (provider: anthropic). Read by the firewall only, never by the chat.
# Empty = Claude calls fail closed (502).
ANTHROPIC_API_KEY=

# --- Postgres (audit database) ---
POSTGRES_USER=firewall
POSTGRES_PASSWORD=firewall
POSTGRES_DB=firewall

# --- Telemetry (optional Phoenix, `--profile observability`) ---
# Empty disables export. With Phoenix in Compose: http://phoenix:6006/v1/traces
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_PROJECT=ai-control-layer
